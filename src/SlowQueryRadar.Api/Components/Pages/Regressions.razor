@* src/SlowQueryRadar.Api/Components/Pages/Regressions.razor *@
@page "/regressions"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Regressions · RADAR</PageTitle>
<div class="d-flex justify-space-between align-center mb-6 flex-wrap gap-3"><div><MudText Typo="Typo.overline" Class="radar-muted">SIGNAL HISTORY</MudText><MudText Typo="Typo.h4">Regression timeline</MudText><MudText Class="radar-muted">Changes worth investigating, ordered by fleet impact.</MudText></div><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload">Export CSV</MudButton></div>
<div class="radar-card radar-card-elevated pa-5"><div class="regression-timeline">@foreach (var item in Items) { <div class="regression-item"><div class="regression-dot" style="background:@item.Color"></div><div class="regression-line"></div><div class="regression-content"><div class="d-flex justify-space-between align-start flex-wrap gap-2"><div><MudText Typo="Typo.caption" Class="radar-muted">@item.When · @item.Tenant</MudText><MudText Typo="Typo.h6" Class="mt-1">@item.Title</MudText></div><MudChip T="string" Size="Size.Small" Color="@item.ChipColor">@item.Delta</MudChip></div><div class="radar-grid radar-grid-2 mt-4"><div><span class="radar-muted text-caption">BASELINE</span><div class="radar-metric">@item.Baseline ms p95</div></div><div><span class="radar-muted text-caption">NOW</span><div class="radar-metric" style="color:@item.Color">@item.Now ms p95</div></div></div><MudText Class="radar-muted mt-3"><strong>Suspected cause:</strong> @item.Cause</MudText><MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-3" OnClick="() => Open(item.Tenant)">Open query <MudIcon Icon="@Icons.Material.Filled.ArrowForward" /></MudButton></div></div> }</div></div>
@code { private IReadOnlyList<RegressionItem> Items => [new("09:42 UTC", "Bluebird", "Orders.Search crossed the critical threshold", 410, 842, "+105%", "Plan changed after statistics refresh.", "#FF5C6C", Color.Error), new("Yesterday · 18:20 UTC", "Juniper", "Invoice lookup latency is climbing", 220, 416, "+89%", "Parameter distribution shifted toward large accounts.", "#F5B544", Color.Warning), new("Mar 18 · 12:05 UTC", "Cobalt", "Catalog lookup lost its covering path", 108, 192, "+78%", "New projection added a key lookup.", "#6AA7FF", Color.Info)]; private void Open(string tenant) => Nav.NavigateTo($"/queries/{Uri.EscapeDataString(tenant)}/regression"); private sealed record RegressionItem(string When, string Tenant, string Title, int Baseline, int Now, string Delta, string Cause, string Color, Color ChipColor); }
