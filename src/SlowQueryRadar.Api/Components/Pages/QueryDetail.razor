@page "/queries/{Target}/{Hash}"
@rendermode InteractiveServer

<PageTitle>Query detail · RADAR</PageTitle>
<div class="d-flex justify-space-between align-center mb-6">
    <div>
        <MudText Typo="Typo.overline" Class="radar-muted">QUERY DETAIL / @Target</MudText>
        <MudText Typo="Typo.h4">Orders.Search</MudText>
        <MudText Class="radar-muted">Normalized hash <span class="radar-code">@Hash</span></MudText>
    </div>
    <MudButton Href="/tenants" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack">Back to tenant</MudButton>
</div>
<div class="radar-grid radar-grid-2">
    <SqlViewer Sql="@Sql" NormalizeLiterals="_normalize" />
    <div class="radar-card radar-card-elevated pa-4">
        <div class="d-flex justify-space-between align-center">
            <MudText Typo="Typo.subtitle1">Query pressure</MudText>
            <MudChip T="string" Color="Color.Error">CRITICAL</MudChip>
        </div>
        <div class="radar-grid radar-grid-2 mt-4">
            <div>
                <div class="radar-muted">P95 DURATION</div>
                <div class="radar-metric text-h4">842 ms</div>
            </div>
            <div>
                <div class="radar-muted">EXECUTIONS</div>
                <div class="radar-metric text-h4">18,420</div>
            </div>
        </div>
        <MudSwitch @bind-Value="_normalize" Color="Color.Primary" Label="Normalize literals" Class="mt-4" />
    </div>
</div>
<MudTabs Rounded="true" TabPanelsClass="pa-0 mt-5">
    <MudTabPanel Text="Findings">
        <div class="radar-grid radar-grid-2 mt-4">
            @foreach (var finding in Findings)
            {
                <div class="radar-card pa-4">
                    <div class="d-flex justify-space-between">
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">@finding.Severity</MudChip>
                        <span class="radar-pill radar-muted">@finding.Confidence confidence</span>
                    </div>
                    <MudText Typo="Typo.h6" Class="mt-3">@finding.Title</MudText>
                    <MudText Class="radar-muted mt-2">@finding.Why</MudText>
                    <div class="radar-code mt-3 pa-3" style="background:var(--radar-bg)">@finding.Evidence</div>
                    <MudText Class="mt-3" Style="color:var(--radar-accent)">→ @finding.Fix</MudText>
                </div>
            }
        </div>
    </MudTabPanel>
    <MudTabPanel Text="Plan">
        <PlanGraph Operators="Plan" />
    </MudTabPanel>
    <MudTabPanel Text="History">
        <div class="radar-card pa-6 mt-4">
            <MudText Typo="Typo.subtitle1">Average duration · 24h</MudText>
            <MetricSpark Values="@History" />
            <div class="radar-metric text-h3 mt-4">+32.4%</div>
            <MudText Class="radar-muted">Regression detected after plan change at 14:20 UTC.</MudText>
        </div>
    </MudTabPanel>
    <MudTabPanel Text="Benchmark">
        <div class="radar-card pa-6 mt-4">
            <MudText Typo="Typo.subtitle1">Before / after benchmark</MudText>
            <div class="radar-grid radar-grid-2 mt-5">
                <div>
                    <span class="radar-muted">ORIGINAL P95</span>
                    <div class="radar-metric text-h4">842 ms</div>
                    <MudProgressLinear Value="84" Color="Color.Error" />
                </div>
                <div>
                    <span class="radar-muted">CANDIDATE P95</span>
                    <div class="radar-metric text-h4" style="color:var(--radar-accent)">416 ms</div>
                    <MudProgressLinear Value="42" Color="Color.Primary" />
                </div>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6" StartIcon="@Icons.Material.Filled.PlayArrow">Run benchmark</MudButton>
        </div>
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter] public string Target { get; set; } = string.Empty;
    [Parameter] public string Hash { get; set; } = string.Empty;

    private bool _normalize;

    private string Sql => "SELECT o.Id, o.Status, o.CreatedAt\nFROM dbo.Orders AS o\nWHERE o.TenantId = 42\n  AND o.CreatedAt >= '2025-01-01'\nORDER BY o.CreatedAt DESC";

    private IReadOnlyList<double> History => [240, 280, 260, 310, 340, 420, 510, 620, 842];
    private IReadOnlyList<PlanGraph.PlanNode> Plan => [new("Index Seek", 18, 18420, false, "IX_Orders_Tenant"), new("Key Lookup", 47, 18420, true, "Orders"), new("Sort", 35, 18420, false, "Orders")];

    private IReadOnlyList<FindingCard> Findings => [new("High", "Key lookup amplification", "18,420 executions · 18,420 lookups · 842 ms p95", "Repeated lookups amplify IO and latency.", "Add included columns after review; never auto-apply.", "High"), new("Medium", "Parameter-sensitive plan", "StdDev 2.4× average · 3 plans", "Different parameter shapes may receive unsuitable plans.", "Compare parameter shapes and plan history.", "Medium")];

    private sealed record FindingCard(string Severity, string Title, string Evidence, string Why, string Fix, string Confidence);
}
