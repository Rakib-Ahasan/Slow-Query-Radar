@page "/query/{QueryId:long}"
@rendermode InteractiveServer
@inject IQueryStoreCollector Collector
@inject SqlAnalyzer Analyzer
@inject ISuggestionEngine Suggester
@inject QueryBenchmarker Benchmarker
@inject BenchmarkHistoryStore BenchmarkHistoryStore
@inject IJSRuntime JS
@inject ILogger<QueryDetail> Logger
@inject NavigationManager Navigation

<PageTitle>Query @QueryId</PageTitle>

@if (_loading)
{
    <MudAlert Severity="MudSeverity.Info">
        <MudProgressCircular Class="mr-2" Indeterminate="true" Size="Size.Small" />
        Loading query @QueryId...
    </MudAlert>
}
else if (_error is not null)
{
    <MudAlert Severity="MudSeverity.Error">
        @_error
        <MudButton Class="ml-2" Variant="Variant.Outlined" OnClick="BackToDashboard">Back to Dashboard</MudButton>
    </MudAlert>
}
else if (_notFound)
{
    <MudAlert Severity="MudSeverity.Warning">
        Query @QueryId not found in the last 24h.
        <MudButton Class="ml-2" Variant="Variant.Outlined" OnClick="BackToDashboard">Back to Dashboard</MudButton>
    </MudAlert>
}
else if (_snapshot is null)
{
    <MudAlert Severity="MudSeverity.Info">Loading snapshot...</MudAlert>
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">Query @QueryId</MudText>
    <MudTabs Rounded="true" Elevation="1">
        <MudTabPanel Text="SQL">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h6">SQL text</MudText>
                <MudButton Variant="Variant.Outlined" OnClick="CopySqlAsync">Copy SQL</MudButton>
            </MudStack>
            <pre class="sql-block">@_snapshot.SqlText</pre>
        </MudTabPanel>
        <MudTabPanel Text="Findings">
            @if (_analysis is null || _analysis.Findings.Count == 0)
            {
                <MudText>No findings are available for this query.</MudText>
            }
            else
            {
                <MudList T="Finding">
                    @foreach (var finding in _analysis.Findings)
                    {
                        <MudListItem>
                            <MudChip Color="SeverityColor(finding.Severity.ToString())" Size="Size.Small">@finding.Severity</MudChip>
                            <MudText Class="ml-2">@finding.Message</MudText>
                            @if (!string.IsNullOrWhiteSpace(finding.Evidence))
                            {
                                <MudText Typo="Typo.caption">@finding.Evidence</MudText>
                            }
                        </MudListItem>
                    }
                </MudList>
            }
        </MudTabPanel>
        <MudTabPanel Text="Suggested fix">
            @if (_suggestion is null)
            {
                <MudText>No suggestion is available.</MudText>
            }
            else
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h6">Deterministic fix</MudText>
                    <MudButton Variant="Variant.Outlined" OnClick="CopyFixAsync">Copy fix</MudButton>
                </MudStack>
                 <pre class="sql-block">@_suggestion.DeterministicFix</pre>
                 @if (!string.IsNullOrWhiteSpace(_suggestion.AiExplanation))
                {
                    <MudAlert Severity="MudSeverity.Info">@_suggestion.AiExplanation</MudAlert>
                }
            }
        </MudTabPanel>
        <MudTabPanel Text="Benchmark">
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_warmupRuns" Label="Warmup runs" Min="0" Disabled="@_benchmarking" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_measuredRuns" Label="Measured runs" Min="1" Disabled="@_benchmarking" />
                </MudItem>
            </MudGrid>
            @if (_benchmarking)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            }
            @if (_benchmark is not null)
            {
                <MudGrid Class="mb-4">
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.caption" Style="text-transform:uppercase">Duration P50</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">@_benchmark.DurationP50Ms.ToString("F2") <MudText Inline="true" Typo="Typo.body2">ms</MudText></MudText>
                            @if (_baseline is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="GetDeltaColor(_baseline.DurationP50Ms, _benchmark.DurationP50Ms)">@GetDeltaText(_baseline.DurationP50Ms, _benchmark.DurationP50Ms)</MudChip>
                            }
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.caption" Style="text-transform:uppercase">Duration P95</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">@_benchmark.DurationP95Ms.ToString("F2") <MudText Inline="true" Typo="Typo.body2">ms</MudText></MudText>
                            @if (_baseline is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="GetDeltaColor(_baseline.DurationP95Ms, _benchmark.DurationP95Ms)">@GetDeltaText(_baseline.DurationP95Ms, _benchmark.DurationP95Ms)</MudChip>
                            }
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.caption" Style="text-transform:uppercase">Logical Reads</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">@_benchmark.LogicalReads</MudText>
                            @if (_baseline is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="GetDeltaColor(_baseline.LogicalReads, _benchmark.LogicalReads)">@GetDeltaText(_baseline.LogicalReads, _benchmark.LogicalReads)</MudChip>
                            }
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.caption" Style="text-transform:uppercase">Executions</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold">@_measuredRuns <MudText Inline="true" Typo="Typo.body2">runs</MudText></MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
            <MudChart ChartType="ChartType.Line" ChartSeries="_chartSeries" ChartLabels="_chartLabels" Width="100%" Height="320px" Class="ma-2" />
            @if (_baseline is null && _current is not null)
            {
                <MudAlert Class="mt-4" Severity="MudSeverity.Info">Run and save a baseline before applying fixes to compare.</MudAlert>
            }
            @if (_baseline is not null && _current is not null)
            {
                <MudPaper Elevation="1" Class="pa-4 mt-4">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.caption">Duration</MudText>
                            <MudText Typo="Typo.h5" Class="font-weight-bold">@GetImprovementText(_baseline.DurationP50Ms, _current.DurationP50Ms, "faster")</MudText>
                            <MudText Typo="Typo.caption">@_baseline.DurationP50Ms.ToString("F1")ms ? @_current.DurationP50Ms.ToString("F1")ms</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.caption">Logical Reads</MudText>
                            <MudText Typo="Typo.h5" Class="font-weight-bold">@GetImprovementText(_baseline.LogicalReads, _current.LogicalReads, "less")</MudText>
                            <MudText Typo="Typo.caption">@_baseline.LogicalReads ? @_current.LogicalReads</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
            <MudStack Row="true" Spacing="3" Class="mt-4">
                <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="RunBenchmarkAsync" Disabled="@_benchmarking">RUN BENCHMARK</MudButton>
                <MudButton Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Bookmark" OnClick="SaveBaselineAsync" Disabled="@(_current is null || _benchmarking)">SAVE AS BASELINE</MudButton>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetBenchmark" Disabled="@_benchmarking">RESET</MudButton>
            </MudStack>
            @if (_benchmarkError is not null)
            {
                <MudAlert Class="mt-4" Severity="MudSeverity.Warning" Icon="@Icons.Material.Filled.Warning">@_benchmarkError</MudAlert>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public long QueryId { get; set; }

    private SlowQuerySnapshot? _snapshot;
    private AnalysisResult? _analysis;
    private Suggestion? _suggestion;
    private BenchmarkResultDto? _benchmark;
    private BenchmarkResult? _baseline;
    private BenchmarkResult? _current;
    private int _warmupRuns = 1;
    private int _measuredRuns = 5;
    private bool _benchmarking;
    private string? _benchmarkError;
    private bool _loading;
    private string? _error;
    private bool _notFound;
    private readonly string[] _chartLabels = ["Duration P50", "Duration P95", "Logical Reads"];
    private List<ChartSeries<double>> _chartSeries = [];

    protected override async Task OnParametersSetAsync()
    {
        Logger.LogInformation("QueryDetail OnParametersSetAsync QueryId={QueryId}", QueryId);
        _loading = true;
        _snapshot = null;
        _analysis = null;
        _suggestion = null;
        _error = null;
        _notFound = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var cancellationSource = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var ct = cancellationSource.Token;
            var snapshot = await Collector.GetByQueryIdAsync(QueryId, ct);
            Logger.LogInformation(
                "QueryDetail: GetByQueryIdAsync returned snapshot={IsNull}, SqlTextLength={Length}",
                snapshot is null,
                snapshot?.SqlText?.Length ?? 0);
            if (snapshot is null)
            {
                _notFound = true;
                return;
            }

            var analysis = await Analyzer.AnalyzeAsync(snapshot, Array.Empty<DapperLogEntry>(), ct);
            Logger.LogInformation("QueryDetail: Analyzer returned {Count} findings", analysis.Findings.Count);
            var suggestion = await Suggester.BuildSuggestionAsync(analysis, snapshot.SqlText, ct);
            Logger.LogInformation(
                "QueryDetail: Suggestion deterministic length={Length}",
                suggestion.DeterministicFix?.Length ?? 0);
            _snapshot = snapshot;
            _analysis = analysis;
            _suggestion = suggestion;
        }
        catch (QueryStoreDisabledException exception)
        {
            _error = $"Query Store is disabled: {exception.Message}";
        }
        catch (Microsoft.Data.SqlClient.SqlException exception)
        {
            _error = $"Database error: {exception.Message}";
        }
        catch (OperationCanceledException)
        {
            _error = "Query timed out after 30 seconds.";
        }
        catch (Exception exception)
        {
            _error = $"Unexpected error: {exception.Message}";
            Logger.LogError(exception, "QueryDetail load failed");
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunBenchmarkAsync()
    {
        _benchmarking = true;
        _benchmarkError = null;
        try
        {
            if (_snapshot is null)
            {
                return;
            }

            var benchmark = await Benchmarker.RunAsync(
                _snapshot.SqlText,
                (object?)null,
                _warmupRuns,
                _measuredRuns,
                CancellationToken.None);
            _current = benchmark;
            _benchmark = ApiMapper.ToDto(benchmark);
            UpdateChartSeries();
        }

        catch (UnsafeQueryException exception)
        {
            _benchmarkError = $"Cannot benchmark this query: {exception.Message}";
        }
        catch (Microsoft.Data.SqlClient.SqlException exception)
        {
            _benchmarkError = $"Database error: {exception.Message}";
        }
        catch (Exception exception)
        {
            _benchmarkError = $"Unexpected error: {exception.Message}";
        }
        finally
        {
            _benchmarking = false;
        }
    }

    private async Task SaveBaselineAsync()
    {
        if (_snapshot is null || _current is null)
        {
            return;
        }

        await BenchmarkHistoryStore.SaveAsync(
            _snapshot.NormalizedSqlHash,
            _snapshot.SqlText,
            "before",
            _current,
            null,
            CancellationToken.None);
        _baseline = _current;
        UpdateChartSeries();
    }

    private void UpdateChartSeries()
    {
        _chartSeries = [];
        if (_baseline is not null)
        {
            _chartSeries.Add(new ChartSeries<double>
            {
                Name = "Baseline",
                    Data = new ChartData<double>(new[] { _baseline.DurationP50Ms, _baseline.DurationP95Ms, (double)_baseline.LogicalReads })
            });
        }

        if (_current is not null)
        {
            _chartSeries.Add(new ChartSeries<double>
            {
                Name = "Current",
                    Data = new ChartData<double>(new[] { _current.DurationP50Ms, _current.DurationP95Ms, (double)_current.LogicalReads })
            });
        }
    }

    private void ResetBenchmark()
    {
        _benchmark = null;
        _current = null;
        _benchmarkError = null;
        UpdateChartSeries();
    }

    private static double Improvement(double before, double after) => before == 0 ? 0 : (before - after) / before * 100;

    private static Color GetDeltaColor(double before, double after) => Improvement(before, after) switch
    {
        >= 50 => Color.Success,
        >= 20 => Color.Warning,
        >= 0 => Color.Default,
        _ => Color.Error
    };

    private static string GetDeltaText(double before, double after)
    {
        var improvement = Improvement(before, after);
        return $"{(improvement < 0 ? "?" : "?")} {Math.Abs(improvement):F0}%";
    }

    private static string GetImprovementText(double before, double after, string suffix)
    {
        var improvement = Improvement(before, after);
        return $"{Math.Abs(improvement):F1}% {(improvement < 0 ? "worse" : suffix)}";
    }

    private Task CopySqlAsync() => JS.InvokeVoidAsync("navigator.clipboard.writeText", _snapshot?.SqlText ?? string.Empty).AsTask();

    private Task CopyFixAsync() => JS.InvokeVoidAsync("navigator.clipboard.writeText", _suggestion?.DeterministicFix ?? string.Empty).AsTask();

    private void BackToDashboard() => Navigation.NavigateTo("/");

    private static Color SeverityColor(string severity) => severity switch
    {
        "Critical" => Color.Error,
        "High" => Color.Error,
        "Medium" => Color.Warning,
        _ => Color.Info
    };
}
