@* src/SlowQueryRadar.Api/Components/Pages/Tenants.razor *@
@page "/tenants"
@rendermode InteractiveServer
@inject DemoDataService Demo
@inject NavigationManager Nav

<PageTitle>Tenants · RADAR</PageTitle>
<div class="d-flex justify-space-between align-center mb-6 flex-wrap gap-3"><div><MudText Typo="Typo.overline" Class="radar-muted">TENANT TELEMETRY</MudText><MudText Typo="Typo.h4">Database fleet</MudText></div><MudSelect T="string" @bind-Value="_rank" Dense="true" Variant="Variant.Outlined" Label="Rank by" Style="min-width:180px"><MudSelectItem Value="@("impact")">Impact</MudSelectItem><MudSelectItem Value="@("duration")">Duration</MudSelectItem><MudSelectItem Value="@("executions")">Executions</MudSelectItem></MudSelect></div>
<div class="radar-card radar-card-elevated pa-2 radar-table"><MudTable T="TenantRow" Items="Rows" Dense="true" Hover="true"><HeaderContent><MudTh>Tenant</MudTh><MudTh>Status</MudTh><MudTh>Queries</MudTh><MudTh>Avg ms · 24h</MudTh><MudTh>Trend</MudTh><MudTh>Pressure</MudTh></HeaderContent><RowTemplate><MudTd><MudButton Variant="Variant.Text" Class="pa-0" OnClick="() => Open(context.Name)">@context.Name</MudButton><div class="radar-muted text-caption">@context.Group</div></MudTd><MudTd><SeverityChip Severity="@context.Severity" /></MudTd><MudTd><span class="radar-metric">@context.Queries</span></MudTd><MudTd><span class="radar-metric">@context.AvgMs.ToString("F0")</span></MudTd><MudTd><MetricSpark Values="@context.Trend" /></MudTd><MudTd><MudProgressLinear Value="@context.Pressure" Color="@(context.Pressure > 80 ? Color.Error : context.Pressure > 55 ? Color.Warning : Color.Primary)" /></MudTd></RowTemplate></MudTable></div>
@code { private string _rank = "impact"; private IReadOnlyList<TenantRow> Rows => Demo.Tenants.Select((name, index) => new TenantRow(name, index % 2 == 1 ? "Platform" : "Commerce", 42 + index * 13, 118 + index * 64, index == 1 ? "Critical" : index == 4 ? "Medium" : "Low", Enumerable.Range(0, 8).Select(x => (double)(80 + index * 20 + x * (index + 2))).ToArray(), 25 + index * 13)).ToArray(); private void Open(string name) => Nav.NavigateTo($"/queries/{Uri.EscapeDataString(name)}/demo"); private sealed record TenantRow(string Name, string Group, int Queries, double AvgMs, string Severity, IReadOnlyList<double> Trend, double Pressure); }
