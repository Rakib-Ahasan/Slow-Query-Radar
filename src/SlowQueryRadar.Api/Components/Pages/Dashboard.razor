@page "/"
@rendermode InteractiveServer
@inject DemoDataService Demo
@inject NavigationManager Nav

<PageTitle>Fleet overview · RADAR</PageTitle>
<div class="d-flex justify-space-between align-center mb-8 flex-wrap gap-4">
    <div><MudText Typo="Typo.overline" Class="radar-muted">MISSION CONTROL / FLEET OVERVIEW</MudText><MudText Typo="Typo.h3" Class="radar-brand">Know where the heat is.</MudText><MudText Class="radar-muted">A calm, read-only view of query pressure across your tenant databases.</MudText></div>
    <div class="d-flex gap-2"><MudChip T="string" Color="Color.Success" Variant="Variant.Outlined">● LIVE COLLECTION</MudChip><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload">Export report</MudButton></div>
</div>
<div class="radar-grid radar-grid-4 mb-4">
    <div class="radar-card radar-kpi radar-kpi-accent"><div class="radar-muted">TENANTS HEALTHY</div><div class="radar-metric text-h3 mt-2">@(Demo.Tenants.Count - 1)</div><div class="radar-muted">of @Demo.Tenants.Count monitored</div></div>
    <div class="radar-card radar-kpi"><div class="radar-muted">SLOW QUERIES / 24H</div><div class="radar-metric text-h3 mt-2">1,284</div><div class="radar-muted"><span style="color:var(--radar-warning)">+8.4%</span> vs previous period</div></div>
    <div class="radar-card radar-kpi"><div class="radar-muted">REGRESSIONS</div><div class="radar-metric text-h3 mt-2" style="color:var(--radar-critical)">7</div><div class="radar-muted">3 need attention</div></div>
    <div class="radar-card radar-kpi"><div class="radar-muted">EST. TIME SAVED</div><div class="radar-metric text-h3 mt-2" style="color:var(--radar-accent)">4.8h</div><div class="radar-muted">if top fixes land</div></div>
</div>
<div class="radar-grid radar-grid-2 mb-4">
    <RadarChart Blips="Demo.Blips" BlipClicked="OpenTenant" />
    <div class="radar-card radar-card-elevated pa-4"><div class="d-flex justify-space-between align-center mb-4"><div><MudText Typo="Typo.subtitle1">Top features by pain</MudText><MudText Typo="Typo.caption" Class="radar-muted">Weighted impact across fleet</MudText></div><MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" /></div>@foreach (var feature in Demo.Features) { <div class="mb-4"><div class="d-flex justify-space-between mb-1"><span>@feature.Feature</span><span class="radar-code radar-muted">@feature.Value.ToString("F0")</span></div><MudProgressLinear Value="@feature.Value" Color="@(feature.Value > 80 ? Color.Error : feature.Value > 60 ? Color.Warning : Color.Primary)" Rounded="true" /></div> }</div>
</div>
<HeatmapGrid Rows="Demo.Tenants" Buckets="Demo.Heatmap.Select(x => x.Bucket).Distinct().ToArray()" Cells="Demo.Heatmap" />
<div class="d-flex justify-space-between align-center mb-3 mt-6"><div><MudText Typo="Typo.h5">Fix once, help N tenants</MudText><MudText Class="radar-muted">Shared query patterns create leverage across the fleet.</MudText></div><MudButton Href="/regressions" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward">View all regressions</MudButton></div>
<div class="radar-grid radar-grid-2">@foreach (var fix in new[] { ("Orders.Search", "Covering index opportunity", 6, "2.1h"), ("Billing.Invoice", "Parameter-sensitive plan", 4, "1.4h") }) { <div class="radar-card pa-4"><div class="d-flex justify-space-between"><div><MudChip T="string" Size="Size.Small" Color="Color.Primary">@fix.Item1</MudChip><MudText Typo="Typo.subtitle1" Class="mt-3">@fix.Item2</MudText></div><div class="radar-metric" style="color:var(--radar-accent)">@fix.Item4</div></div><div class="d-flex justify-space-between align-center mt-4"><span class="radar-muted">benefits <strong>@fix.Item3 tenants</strong></span><MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/tenants">Inspect</MudButton></div></div> }</div>
@code { private void OpenTenant(RadarChart.RadarBlip blip) => Nav.NavigateTo($"/tenants?tenant={Uri.EscapeDataString(blip.Name)}"); }
