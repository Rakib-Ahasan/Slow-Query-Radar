@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IQueryStoreCollector Collector
@inject NavigationManager Nav

<PageTitle>Slow Query Radar</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Primary" Size="Size.Large" />
    <MudText Typo="Typo.h4">Slow Query Radar</MudText>
</MudStack>

<MudGrid Class="mb-4">
    @if (_loading && _queries.Count == 0)
    {
        @for (var index = 0; index < 4; index++)
        {
            <MudItem xs="12" sm="6" md="3"><MudPaper Elevation="2" Class="pa-4"><MudSkeleton Height="40px" /><MudSkeleton Width="70%" /></MudPaper></MudItem>
        }
    }
    else
    {
        <MudItem xs="12" sm="6" md="3"><MudPaper Elevation="2" Class="pa-4"><MudStack Row="true" AlignItems="AlignItems.Center"><MudAvatar Color="Color.Primary"><MudIcon Icon="@Icons.Material.Filled.Search" /></MudAvatar><MudStack><MudText Typo="Typo.caption">Queries Reviewed</MudText><MudText Typo="Typo.h4" Class="font-weight-bold">@_queries.Count</MudText></MudStack></MudStack></MudPaper></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudPaper Elevation="2" Class="pa-4"><MudStack Row="true" AlignItems="AlignItems.Center"><MudAvatar Color="Color.Error"><MudIcon Icon="@Icons.Material.Filled.Warning" /></MudAvatar><MudStack><MudText Typo="Typo.caption">High-Priority</MudText><MudText Typo="Typo.h4" Class="font-weight-bold">@HighPriorityCount</MudText></MudStack></MudStack></MudPaper></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudPaper Elevation="2" Class="pa-4"><MudStack Row="true" AlignItems="AlignItems.Center"><MudAvatar Color="Color.Success"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></MudAvatar><MudStack><MudText Typo="Typo.caption">Validated Fixes</MudText><MudText Typo="Typo.h4" Class="font-weight-bold">0</MudText></MudStack></MudStack></MudPaper></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudPaper Elevation="2" Class="pa-4"><MudStack Row="true" AlignItems="AlignItems.Center"><MudAvatar Color="Color.Info"><MudIcon Icon="@Icons.Material.Filled.Speed" /></MudAvatar><MudStack><MudText Typo="Typo.caption">CPU Saved %</MudText><MudText Typo="Typo.h4" Class="font-weight-bold">0.00%</MudText></MudStack></MudStack></MudPaper></MudItem>
    }
</MudGrid>

@if (_error is not null)
{
    <MudAlert Severity="MudSeverity.Error" Class="mb-4">@_error</MudAlert>
}

<MudTable T="SlowQueryDto" Items="_queries" Hover="true" Dense="true" Loading="_loading" OnRowClick="@HandleRowClick">
    <HeaderContent>
        <MudTh>QueryId</MudTh>
        <MudTh>Exec Count</MudTh>
        <MudTh>Avg ms</MudTh>
        <MudTh>Total CPU ms</MudTh>
        <MudTh>Impact</MudTh>
        <MudTh>Severity</MudTh>
        <MudTh>Action</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="QueryId">@context.QueryId</MudTd>
        <MudTd DataLabel="Exec Count">@context.ExecCount</MudTd>
        <MudTd DataLabel="Avg ms">@context.AvgDurationMs.ToString("F2")</MudTd>
        <MudTd DataLabel="Total CPU ms">@context.TotalCpuMs.ToString("F2")</MudTd>
        <MudTd DataLabel="Impact">
            <MudText Typo="Typo.caption">@context.ImpactScore.ToString("F2")</MudText>
            <MudProgressLinear Color="GetSeverityColor(context.ImpactScore)" Value="GetImpactPercent(context.ImpactScore)" />
        </MudTd>
        <MudTd DataLabel="Severity"><MudChip T="string" Color="GetSeverityColor(context.ImpactScore)" Size="Size.Small">@GetSeverity(context.ImpactScore)</MudChip></MudTd>
        <MudTd DataLabel="Action"><MudButton Size="Size.Small" Variant="Variant.Outlined" @onclick="() => OpenQuery(context.QueryId)">Open</MudButton></MudTd>
    </RowTemplate>
</MudTable>

@code {
    private IReadOnlyList<SlowQueryDto> _queries = Array.Empty<SlowQueryDto>();
    private Timer? _refreshTimer;
    private bool _loading;
    private string? _error;

    private int HighPriorityCount => _queries.Count(query => query.ImpactScore >= 1_000_000);

    private static string GetSeverity(double impact) => impact switch
    {
        >= 1_000_000 => "High",
        >= 100_000 => "Medium",
        >= 10_000 => "Low",
        _ => "Info"
    };

    private double MaxImpact => _queries.Count == 0 ? 0 : _queries.Max(query => query.ImpactScore);

    private double GetImpactPercent(double impact) => MaxImpact == 0 ? 0 : impact / MaxImpact * 100;

    private static Color GetSeverityColor(double impact) => GetSeverity(impact) switch
    {
        "High" => Color.Error,
        "Medium" => Color.Warning,
        "Low" => Color.Info,
        _ => Color.Default
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _refreshTimer = new Timer(_ => _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        }), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }


    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var snapshots = await Collector.CollectTopSlowQueriesAsync(20, TimeSpan.FromHours(24), CancellationToken.None);
            _queries = snapshots.Select(ApiMapper.ToDto).ToArray();
            _error = null;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenQuery(long queryId)
    {
        Nav.NavigateTo($"/query/{queryId}", forceLoad: true);
    }

    private void HandleRowClick(TableRowClickEventArgs<SlowQueryDto> args)
    {
        if (args.Item is not null)
        {
            OpenQuery(args.Item.QueryId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_refreshTimer is not null)
        {
            await _refreshTimer.DisposeAsync();
        }
    }
}
