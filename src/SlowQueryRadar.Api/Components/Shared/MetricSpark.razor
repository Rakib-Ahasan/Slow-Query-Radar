@* src/SlowQueryRadar.Api/Components/Shared/MetricSpark.razor *@
<svg viewBox="0 0 120 32" class="metric-spark" aria-label="Metric trend">@if (Values.Count > 1) { <polyline points="@Points" fill="none" stroke="#2DD4BF" stroke-width="2" /> }</svg>
@code {
    /// <summary>Metric values.</summary>
    [Parameter] public IReadOnlyList<double> Values { get; set; } = [];
    private string Points => string.Join(" ", Values.Select((value, index) => $"{index * 120d / Math.Max(1, Values.Count - 1):F1},{32 - Math.Clamp(value / Math.Max(1, Values.Max()) * 28, 1, 30):F1}"));
}
