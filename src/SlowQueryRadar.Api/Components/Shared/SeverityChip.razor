@* src/SlowQueryRadar.Api/Components/Shared/SeverityChip.razor *@
<span class="radar-severity-chip" data-severity="@Severity" style="--severity-color:@GetColor(Severity)" role="status">@Severity</span>

@code {
    [Parameter, EditorRequired] public string Severity { get; set; } = string.Empty;

    private static string GetColor(string severity) => severity switch
    {
        "Critical" or "High" => "var(--radar-critical)",
        "Medium" => "var(--radar-warning)",
        "Low" => "var(--radar-info)",
        _ => "var(--radar-muted)"
    };
}
