@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.Speed" Class="mr-2" />
        <MudText Typo="Typo.h6">Slow Query Radar</MudText>
        <MudSpacer />
        <MudButton Href="/reports/weekly" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Assessment">Weekly Report</MudButton>
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleTheme" aria-label="Toggle theme" />
        <MudIconButton Icon="@Icons.Material.Filled.Code" Color="Color.Inherit" Href="https://github.com/Rakib-Ahasan/Slow-Query-Radar" Target="_blank" aria-label="GitHub repository" />
    </MudAppBar>
    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

<MudPaper Square="true" Elevation="0" Class="pa-3 text-center">
    <MudText Typo="Typo.caption">Slow Query Radar · v0.1 · Read-only · Ai: disabled</MudText>
</MudPaper>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <MudIconButton Class="dismiss" Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" aria-label="Dismiss error" />
</div>

@code {
    private bool _isDarkMode;

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
    }
}
