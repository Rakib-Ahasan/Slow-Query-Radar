@* src/SlowQueryRadar.Api/Components/Layout/MainLayout.razor *@
@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="radar-shell">
    <MudAppBar Elevation="0" Class="radar-appbar">
        <MudIcon Icon="@Icons.Material.Filled.Radar" Color="Color.Inherit" Class="mr-3 radar-brand-mark" />
        <MudText Typo="Typo.h6" Class="font-weight-bold radar-brand">RADAR <span class="radar-muted">/ mission control</span></MudText>
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudNavMenu Class="ml-8">
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Radar">Fleet overview</MudNavLink>
                <MudNavLink Href="/tenants" Icon="@Icons.Material.Filled.Dns">Tenants</MudNavLink>
                <MudNavLink Href="/regressions" Icon="@Icons.Material.Filled.Timeline">Regressions</MudNavLink>
                <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Targets & settings</MudNavLink>
                <MudNavLink Href="/reports/weekly" Icon="@Icons.Material.Filled.Assessment">Weekly Report</MudNavLink>
            </MudNavMenu>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudSpacer />
            <MudMenu Icon="@Icons.Material.Filled.Menu" aria-label="Open navigation menu">
                <MudMenuItem Href="/" Icon="@Icons.Material.Filled.Radar">Fleet overview</MudMenuItem>
                <MudMenuItem Href="/tenants" Icon="@Icons.Material.Filled.Dns">Tenants</MudMenuItem>
                <MudMenuItem Href="/regressions" Icon="@Icons.Material.Filled.Timeline">Regressions</MudMenuItem>
                <MudMenuItem Href="/settings" Icon="@Icons.Material.Filled.Settings">Targets & settings</MudMenuItem>
                <MudMenuItem Href="/reports/weekly" Icon="@Icons.Material.Filled.Assessment">Weekly Report</MudMenuItem>
            </MudMenu>
        </MudHidden>
        <MudSpacer />
        <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="mr-2 radar-pill">READ-ONLY</MudChip>
        <MudTooltip Text="Toggle dark mode">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleThemeAsync" aria-label="Toggle dark mode" />
        </MudTooltip>
        <MudTooltip Text="Open GitHub">
            <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="https://github.com/Rakib-Ahasan/Slow-Query-Radar" Target="_blank" aria-label="Open GitHub repository" />
        </MudTooltip>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="radar-content">
            <div>
                @Body
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<MudPaper Square="true" Elevation="0" Class="app-footer">
    <MudText Typo="Typo.caption">Slow Query Radar · v0.1 · Read-only · Ai: disabled</MudText>
</MudPaper>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <MudIconButton Class="dismiss" Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" aria-label="Dismiss error" />
</div>

@code {
    private bool _isDarkMode = true;

    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0F9F91", PrimaryDarken = "#087F75", PrimaryLighten = "#2DD4BF", Secondary = "#6AA7FF", Tertiary = "#8B9AAF", Success = "#087F75", Warning = "#B7791F", Error = "#C5303F", Info = "#356FC4", Background = "#F4F7F9", Surface = "#FFFFFF", AppbarBackground = "#FFFFFF", DrawerBackground = "#FFFFFF", TextPrimary = "#15202B", TextSecondary = "#526579", Divider = "#D6E0E8"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#2DD4BF", PrimaryDarken = "#14B8A6", PrimaryLighten = "#5EEAD4", Secondary = "#6AA7FF", Success = "#2DD4BF", Warning = "#F5B544", Error = "#FF5C6C", Info = "#6AA7FF", Background = "#0B0F14", Surface = "#121923", AppbarBackground = "#0B0F14", DrawerBackground = "#121923", TextPrimary = "#E6EDF3", TextSecondary = "#8FA3B8", Divider = "#223041"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "system-ui", "-apple-system", "sans-serif"], FontSize = "0.875rem", LineHeight = "1.6" },
            H1 = new H1Typography { FontWeight = "600", LetterSpacing = "-0.02em" }, H2 = new H2Typography { FontWeight = "600", LetterSpacing = "-0.02em" }, H3 = new H3Typography { FontWeight = "600", LetterSpacing = "-0.02em" }, H4 = new H4Typography { FontWeight = "600", LetterSpacing = "-0.02em" }, H5 = new H5Typography { FontWeight = "600", LetterSpacing = "-0.02em" }, H6 = new H6Typography { FontWeight = "600", LetterSpacing = "-0.02em" }, Caption = new CaptionTypography { FontSize = "0.75rem", LetterSpacing = "0.02em" }
        },
         LayoutProperties = new LayoutProperties { DefaultBorderRadius = "12px" }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await JS.InvokeAsync<bool>("localStorage.getItem", "slowQueryRadar.darkMode");
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", "slowQueryRadar.darkMode", _isDarkMode);
    }
}
