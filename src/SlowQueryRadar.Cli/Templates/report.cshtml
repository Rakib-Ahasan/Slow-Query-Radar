@using SlowQueryRadar.Cli.Commands
@using System.Net
@model ReportModel
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Slow Query Radar Report</title>
<style>
body{font-family:Arial,sans-serif;color:#1f2937;margin:2rem}h1{color:#0f3d56}.kpis{display:flex;gap:1rem}.kpi{border:1px solid #cbd5e1;border-radius:6px;padding:1rem;min-width:150px}.kpi strong{display:block;font-size:1.5rem}table{border-collapse:collapse;width:100%;margin:1rem 0}th,td{border:1px solid #cbd5e1;padding:.5rem;text-align:left;vertical-align:top}th{background:#e2e8f0}.finding{margin:.25rem 0}.fix{white-space:pre-wrap;background:#f8fafc;border:1px solid #cbd5e1;padding:.75rem}
</style>
</head>
<body>
<h1>Slow Query Radar Report</h1>
<p>Generated @Model.GeneratedAtUtc.ToString("u")</p>
<div class="kpis"><div class="kpi">Queries<strong>@Model.Queries.Count</strong></div><div class="kpi">Executions<strong>@Model.TotalExecutions</strong></div><div class="kpi">CPU ms<strong>@Model.TotalCpuMs.ToString("F2")</strong></div><div class="kpi">Findings<strong>@Model.FindingCount</strong></div><div class="kpi">High severity<strong>@Model.HighSeverityCount</strong></div></div>
<h2>Top queries</h2>
<table><thead><tr><th>Query ID</th><th>Executions</th><th>Avg ms</th><th>CPU ms</th><th>Impact</th><th>SQL</th></tr></thead><tbody>
@foreach (var row in Model.Queries) {<tr><td>@row.Snapshot.QueryId</td><td>@row.Snapshot.ExecCount</td><td>@row.Snapshot.AvgDurationMs.ToString("F2")</td><td>@row.Snapshot.TotalCpuMs.ToString("F2")</td><td>@row.Snapshot.ImpactScore.ToString("F2")</td><td>@row.Snapshot.SqlText</td></tr>}
</tbody></table>
<h2>Findings and suggested fixes</h2>
@foreach (var row in Model.Queries) {<h3>Query @row.Snapshot.QueryId</h3><ul>@foreach (var finding in row.Analysis.Findings) {<li class="finding"><strong>@finding.Severity</strong>: @finding.Message</li>}</ul><div class="fix">@row.Suggestion.DeterministicFix</div>}
</body>
</html>
