{
  "QueryStore": {
    "ConnectionString": "",
    "TopN": 20,
    "LookbackHours": 24
  },
  "Profiler": {
    "LogParameterValues": false,
    "SlowThresholdMs": 200
  },
  "Ai": {
    "Enabled": false,
    "Endpoint": "",
    "ApiKey": "",
    "Model": "claude-sonnet-4-5",
    "TimeoutSeconds": 10
  },
  "Benchmark": {
    "ConnectionString": "",
    "Environment": "Dev",
    "BlockedServerNames": [
      "prod-sql-01"
    ]
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}